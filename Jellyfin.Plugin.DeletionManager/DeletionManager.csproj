<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Jellyfin 12 / .NET 10 only. Add another target only after live validation on that host. -->
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyVersion>1.3.1.0</AssemblyVersion>
        <FileVersion>1.3.1.0</FileVersion>
        <RootNamespace>Jellyfin.Plugin.DeletionManager</RootNamespace>
        <AssemblyName>Jellyfin.Plugin.DeletionManager</AssemblyName>
        <JellyfinVersion>12.0.0</JellyfinVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
        <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Configuration\configPage.html" />
        <EmbeddedResource Include="Configuration\configPage.html" />
        <None Remove="Web\*.js" />
        <EmbeddedResource Include="Web\*.js" />
    </ItemGroup>

</Project>
